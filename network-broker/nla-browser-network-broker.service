[Unit]
Description=NLA Browser per-session network policy broker
After=local-fs.target

[Service]
Type=simple
User=root
Group=nla-browser
ExecStart=/usr/local/libexec/nlabridged serve /run/nla-browser/broker.sock
Restart=on-failure
RestartSec=2s
Environment=NLA_BROKER_SOCKET_GID=__NLA_BROWSER_GID__
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/run/nla-browser /run/netns

[Install]
WantedBy=multi-user.target
