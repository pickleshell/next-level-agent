# Copy to /etc/nla-browser/network-broker.env and replace every absolute path.
# The proxy placeholder is mandatory and must remain a literal argument.
NLA_BROWSER_MCP_COMMAND_JSON=["/absolute/path/to/node","/absolute/path/to/@playwright/mcp/cli.js","--isolated","--headless","--executable-path","/absolute/path/to/chromium","--proxy-server","__NLA_SESSION_PROXY__"]
